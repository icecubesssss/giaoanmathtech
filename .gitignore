# === Bí mật & môi trường (KHÔNG BAO GIỜ đẩy lên GitHub) ===
.env
.venv/
# === Sản phẩm in ra: máy ai nấy giữ, build lại lúc nào cũng được ===
outputs/
*.aux
*.log
*.out
*.xdv
*.synctex.gz
# === Trạng thái/cache cục bộ từng máy (đẩy lên sẽ gây xung đột liên tục) ===
storage/run_state.json
.tectonic/
__pycache__/
*.pyc
.pytest_cache/
# === Rác hệ điều hành ===
.DS_Store
Thumbs.db
desktop.ini

# === Cấu hình thương hiệu riêng của từng máy (máy ai nấy giữ) ===
config/design_tokens.json

# === Tài liệu nguồn nặng (PDF/Word/PowerPoint): giữ trên máy, KHÔNG đẩy lên repo ===
*.pdf
*.PDF
*.doc
*.docx
*.ppt
*.pptx
*.pptm
*.rtf

# === Tài liệu nguồn nặng trong inputs (ảnh/nén/video): giữ trên máy, KHÔNG đẩy lên repo ===
# (Lưu ý: ảnh trong assets/ và templates/ vẫn được track vì cần cho build)
inputs/**/*.jpg
inputs/**/*.jpeg
inputs/**/*.png
# NGOẠI LỆ: ảnh minh hoạ mà phiếu ĐANG DÙNG phải theo repo, nếu không máy thầy cô
# khác build là gãy ("Unable to load picture"). Quy ước: để trong `images/` cạnh phiếu.
!inputs/seeds/**/images/*.png
!inputs/seeds/**/images/*.jpg
inputs/**/*.zip
inputs/**/*.rar
inputs/**/*.mp4
