# === Bí mật & môi trường (KHÔNG BAO GIỜ đẩy lên GitHub) ===
.env
.venv/
# === Sản phẩm in ra: máy ai nấy giữ, build lại lúc nào cũng được ===
outputs/
*.aux
*.log
*.out
*.xdv
*.synctex.gz
# === Trạng thái/cache cục bộ từng máy (đẩy lên sẽ gây xung đột liên tục) ===
storage/run_state.json
.tectonic/
__pycache__/
*.pyc
.pytest_cache/
# === Rác hệ điều hành ===
.DS_Store
Thumbs.db
desktop.ini

# === Cấu hình thương hiệu riêng của từng máy (máy ai nấy giữ) ===
config/design_tokens.json

# === Ảnh render nháp khi soi lỗi PDF (không cần commit) ===
assets/deck/diag/

# === Tài liệu nguồn nặng (PDF/Word/PowerPoint): giữ trên máy, KHÔNG đẩy lên repo ===
*.pdf
*.PDF
*.doc
*.docx
*.ppt
*.pptx
