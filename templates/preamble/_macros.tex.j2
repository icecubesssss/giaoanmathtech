% --- Bộ ICON NÉT VẼ theo chặng (vector, vẽ bằng MÀU HIỆN HÀNH → in đen trắng vẫn rõ;
%     đây là thứ KHÔI PHỤC nhận diện chặng khi bản in mất hết màu). ---
\newcommand{\iconreview}{\tikz[line width=1.1pt,line cap=round]{% kính lúp
  \draw (0,1pt) circle (3.1pt); \draw (2.3pt,-1.3pt)--(4.7pt,-3.7pt);}}
\newcommand{\iconconcept}{\tikz[line width=1.1pt,line cap=round,line join=round]{% bóng đèn
  \draw (0,1.4pt) circle (3pt);
  \draw (-1.5pt,-1.4pt)--(-1.5pt,-2.7pt)--(1.5pt,-2.7pt)--(1.5pt,-1.4pt);
  \draw (-1.3pt,-3.6pt)--(1.3pt,-3.6pt);}}
\newcommand{\iconpractice}{\tikz[line cap=round]{% tạ tay
  \draw[line width=1.1pt] (-4.2pt,0)--(4.2pt,0);
  \draw[line width=3pt] (-4.2pt,-2.4pt)--(-4.2pt,2.4pt);
  \draw[line width=3pt] (4.2pt,-2.4pt)--(4.2pt,2.4pt);}}
\newcommand{\iconapply}{\tikz[line width=1pt]{% bia bắn (vận dụng/chạm trần)
  \draw (0,0) circle (4pt); \draw (0,0) circle (2pt); \fill (0,0) circle (0.7pt);}}
\newcommand{\iconreflect}{\tikz[line width=1.1pt,line cap=round,line join=round]{% lá cờ
  \draw (-1.4pt,-4.4pt)--(-1.4pt,4.4pt);
  \draw (-1.4pt,4.4pt)--(4.6pt,2.6pt)--(-1.4pt,0.8pt);}}

% Huy hiệu chặng (badge tròn) — màu nền theo chặng, ICON nét vẽ trắng bên trong.
% #1=màu chặng, #2=icon (vd \iconreview).
\newcommand{\stagebadge}[2]{%
  \begin{tikzpicture}[baseline=-3pt]
    \node[circle,fill=#1,inner sep=0pt,minimum size=26pt]{\color{white}#2};
  \end{tikzpicture}}

% Dòng "eyebrow" nhận diện chặng (sắc độ brand, chữ sans nhỏ)
\newcommand{\stageeyebrow}[1]{{\sffamily\footnotesize\color{brand}\textbf{#1}}\par\vspace{2pt}}

% Khối CHẶNG — thanh nhấn trái + nền tô NHẠT theo màu chặng (zoning thị giác).
% #1=số chặng, #2=tiêu đề, #3=màu chặng, #4=icon nét vẽ.
\newtcolorbox{stage}[4]{
  enhanced, breakable, colback=#3!3, colframe=#3,
  boxrule=0pt, arc=6pt, outer arc=6pt,
  top=10pt,bottom=10pt,left=14pt,right=14pt, boxsep=0pt,
  borderline west={3pt}{0pt}{#3},
  overlay unbroken and first={
    \node[anchor=north west,xshift=14pt,yshift=-8pt] (sb) at (frame.north west) {\stagebadge{#3}{#4}};
    \node[anchor=west,text=ink] at ([xshift=9pt]sb.east) {\adjustbox{max width=0.8\linewidth}{\sffamily\bfseries\large #1.\;\;#2}}; },
  before upper={\vspace{32pt}} }

% --- Thanh HÀNH TRÌNH 5 chặng (tuyến "metro") — ICON trong vòng tròn màu chặng,
%     tô đậm chặng hiện tại (#1=1..5; truyền 0 = bản đồ tĩnh, không tô đậm chặng nào).
\newcommand{\journeybar}[1]{%
  \begin{center}\begin{tikzpicture}[x=2.55cm,baseline]
    \draw[line width=1.4pt,rule] (0,0) -- (4,0);
    \foreach \i/\c/\ic/\lb in {%
        0/stage1/{\iconreview}/{Khám phá}, 1/stage2/{\iconconcept}/{Khái niệm},%
        2/stage3/{\iconpractice}/{Luyện tập}, 3/stage4/{\iconapply}/{Vận dụng},%
        4/stage5/{\iconreflect}/{Tổng kết}}{%
      \pgfmathtruncatemacro{\num}{\i+1}%
      \ifnum\num=#1\relax
        \node[circle,fill=\c,minimum size=24pt,inner sep=0pt] (jn\i) at (\i,0) {\color{white}\ic};
        \node[font=\sffamily\bfseries\tiny,text=\c,below=3pt of jn\i,align=center] {\lb};
      \else
        \node[circle,draw=\c!70,line width=0.9pt,fill=\c!12,minimum size=22pt,inner sep=0pt] (jn\i) at (\i,0) {\color{\c}\ic};
        \node[font=\sffamily\tiny,text=muted,below=3pt of jn\i,align=center] {\lb};
      \fi}
  \end{tikzpicture}\end{center}}

