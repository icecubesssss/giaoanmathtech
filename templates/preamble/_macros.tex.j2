% Khung TRỐNG để HS TỰ VẼ HÌNH vào phiếu (Thầy An 2026-07-28: "tạo thêm chỗ cho hs
% vẽ vào đề"). #1 = chiều cao tính bằng cm. Viền đứt mảnh + nhãn nhắc việc ở góc.
\newcommand{\drawbox}[1][3]{%
  \par\nointerlineskip\vspace{6pt}\noindent
  \begin{tikzpicture}
    \draw[rule!70, dashed, line width=0.5pt, rounded corners=3pt]
      (0,0) rectangle (\linewidth, #1);
    \node[anchor=north west, font=\sffamily\scriptsize\itshape, color=muted]
      at (4pt, #1-3pt) {Vẽ hình vào khung này};
  \end{tikzpicture}\par\vspace{4pt}%
}

