% --- Sao MỨC ĐỘ NHẬN THỨC (Bloom). #1 = level: 1 Nhận biết, 2 Thông hiểu,
%     3 Vận dụng (★ vàng, đủ-rỗng cho rõ khi in đen trắng), 4 Vận dụng cao
%     (◆◆◆◆ MÀU KIM CƯƠNG để nổi bật khác hẳn ba mức kia).
\newcommand{\diffstars}[1]{{\footnotesize%
  \ifnum#1>3\color{diamond}\ding{72}\hspace{0.5pt}\ding{72}\hspace{0.5pt}\ding{72}\hspace{0.5pt}\ding{72}\else
  \color{gold}\ding{72}\hspace{0.5pt}%
  \ifnum#1>1\ding{72}\else\ding{73}\fi\hspace{0.5pt}%
  \ifnum#1>2\ding{72}\else\ding{73}\fi\fi}}

% --- QR video lời giải (đặc sản: cầu nối giấy → video). #1 = URL ---
\newcommand{\videoqr}[1]{%
