  \begin{tikzpicture}[baseline=-0.5ex]
    \draw[step=0.25cm,ink!15,line width=0.3pt] (0,0) grid (#1, 1);
    \draw[step=1cm,ink!35,line width=0.5pt] (0,0) grid (#1, 1);
  \end{tikzpicture}%
}
