% Thiết lập Beamer cho Slide TV (16:9) — font sans + toán to, sạch, không "phèn".
% KHÔNG dùng _macros.tex.j2 (đó là linh kiện cho article); slide có theme riêng.
\usefonttheme{professionalfonts}   % nhường việc chọn font toán cho unicode-math
\usepackage{fontspec}
\usepackage{unicode-math}
\def\FONTDIR{((( fonts.dir )))}
% Slide dùng font SANS làm thân (Design System: slide = sans hình học)
\setmainfont{((( fonts.sans_family )))}[Path=\FONTDIR, Extension=((( fonts.sans_ext ))),
  UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic, FontFace={sb}{n}{*-SemiBold} ]
\setsansfont{((( fonts.sans_family )))}[Path=\FONTDIR, Extension=((( fonts.sans_ext ))),
  UprightFont=*-Regular, BoldFont=*-Bold, ItalicFont=*-Italic ]
\setmathfont{((( fonts.math_file )))}[Path=\FONTDIR]

\usepackage{tikz}
\usetikzlibrary{calc,angles,quotes,positioning,arrows.meta}
% Sơ đồ bước giải (đặc sản) — style khối + mũi tên, dùng trong block figure.
\tikzset{
  flownode/.style={draw=ink!70, line width=0.8pt, rounded corners=3pt, fill=neutral,
    inner sep=4pt, font=\sffamily\scriptsize, align=center, minimum height=20pt, text width=2.2cm},
  flowkey/.style={flownode, draw=trap, fill=trap!8},
  flowarrow/.style={-{Stealth[length=5pt]}, line width=0.9pt, draw=brand},
}
\usepackage{adjustbox}   % co hình figure trong cột: giới hạn CẢ bề ngang lẫn chiều cao
\usepackage{pifont}      % dingbat cho nhãn block (bẫy/đích/mẹo/mở màn) — không cần font ngoài
% Ký hiệu góc vuông tại đỉnh #1 giữa hai tia #1->#2 và #1->#3 (dùng trong block figure).
\newcommand{\rightanglemark}[3]{%
  \coordinate (ra1) at ($(#1)!0.26cm!(#2)$);
  \coordinate (ra2) at ($(#1)!0.26cm!(#3)$);
  \draw[line width=0.6pt] (ra1)--($(ra1)+(ra2)-(#1)$)--(ra2);}

((* include "preamble/_colors.tex.j2" *))


% Theme tối giản: bỏ thanh điều hướng, tiêu đề brand, chữ to để đọc cuối lớp.
\usetheme{default}
\setbeamertemplate{navigation symbols}{}
% allowframebreaks mặc định chèn số La Mã ("I", "II"…) vào CUỐI tiêu đề — kể cả
% frame chỉ 1 trang → ra chữ "I" lạc dính vào tiêu đề. Chỉ hiện số từ trang 2 trở đi.
\setbeamertemplate{frametitle continuation}[from second]
\setbeamercolor{normal text}{fg=ink}
\setbeamercolor{structure}{fg=brand}
\setbeamercolor{frametitle}{fg=brand}
\setbeamercolor{block title}{fg=white,bg=ink}
\setbeamercolor{block body}{bg=neutral}
\setbeamerfont{frametitle}{series=\bfseries, size=\LARGE}
\setbeamerfont{normal text}{size=\large}
\setbeamerfont{block title}{series=\bfseries, size=\normalsize}
\usefonttheme{serif}        % để \textbf, \emph dùng đúng face của Be Vietnam Pro
\usefonttheme{professionalfonts}
\renewcommand{\normalsize}{\large}   % nâng cỡ nền: thân slide tối thiểu ~\large

% Watermark mờ căn giữa mọi slide nội dung (slide bìa tắt qua \watermarkfalse)
\newif\ifwatermark\watermarktrue
\setbeamertemplate{background}{%
  \ifwatermark
    \begin{tikzpicture}[remember picture,overlay]
      \node[opacity=0.45] at (current page.center)
        {\includegraphics[width=0.5\paperwidth]{((( assets_dir )))((( branding.watermark_file )))}};
    \end{tikzpicture}%
  \fi}

% Chỗ trống cho slide (đơn giản, không tikz): [[blank]] -> \blank, [[mblank]] -> \rule
\newcommand{\blank}[1][4cm]{\rule[-0.3ex]{#1}{0.5pt}}

% Footline mảnh: tên bài • số slide
\setbeamertemplate{footline}{%
  \vskip3pt%
  \hbox to \paperwidth{%
    \hspace*{0.6cm}%
    \raisebox{-1pt}{\includegraphics[height=12pt]{((( assets_dir )))((( branding.logo_file )))}}%
    \hspace*{4pt}{\scriptsize\color{muted}((* if lesson.grade_label *))((( lesson.grade_label ))) • ((* endif *))Biên soạn: ((( branding.author_name )))}%
    \hfill%
    {\scriptsize\color{muted}Slide \insertframenumber}%
    \hspace*{0.6cm}%
  }%
  \vskip3pt}
\setbeamertemplate{frametitle}{%
  \vspace*{10pt}\hspace*{0.2cm}{\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\insertframetitle}\par
  \vspace{2pt}\hspace*{0.2cm}{\color{brand}\rule{42pt}{3pt}}\par\vspace{4pt}}