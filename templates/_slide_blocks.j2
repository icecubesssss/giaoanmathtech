((= Macro dựng Block cho Slide TV. Khác handout: bỏ dòng kẻ viết tay (writelines),
    không có lời giải. Token [[blank]]/[[mblank]] do filter `tex` xử lý. =))
((* macro render_block(b) *))
((* if b.type == "para" *))
((( b.text | tex )))
\par\medskip
((* elif b.type == "math" *))
\[ ((( b.latex | tex ))) \]
((* elif b.type == "noted" *))
((* if b.variant == "trap" *))\begin{block}{\ding{43}\ \ Bẫy điểm}((( b.text | tex )))\end{block}
((* elif b.variant == "target" *))\begin{block}{\ding{72}\ \ Đích thi vào 10}((( b.text | tex )))\end{block}
((* elif b.variant == "tip" *))\begin{block}{\ding{42}\ \ Mẹo}((( b.text | tex )))\end{block}
((* elif b.variant == "example" *))\begin{block}{\ding{46}\ \ Ví dụ mẫu}((( b.text | tex )))\end{block}
((* else *))\begin{block}{}((( b.text | tex )))\end{block}((* endif *))
\medskip
((* elif b.type == "opener" *))
((= Hình của opener KHÔNG render ở đây: render_blocks đưa nó sang cột phải
    (mode "opener") để chữ + hình luôn cùng một slide, không bị bẻ trang. =))
\begin{block}{\ding{44}\ \ Mở màn thực tế}((( b.text | tex )))\end{block}
\medskip
((* elif b.type == "problem" *))
{\bfseries\color{brand}((( b.label | tex )))}\; ((( b.statement | tex )))
\par\medskip
((* elif b.type == "table" *))
((* if b.caption *)){\color{brand}\small\textbf{((( b.caption | tex )))}}\par\vspace{2pt}
((* endif *))
((* set ncols = (b.headers | length) or ((b.rows[0] | length) if b.rows else 1) *))
\begin{center}\renewcommand{\arraystretch}{1.4}
\begin{tabular}{|((* for i in range(ncols) *))((* if loop.first *))l((* else *))c((* endif *))|((* endfor *))}
\hline
((* if b.headers *))((* for h in b.headers *))((* if not loop.first *)) & ((* endif *))\textbf{((( h | tex )))}((* endfor *)) \\ \hline
((* endif *))((* for row in b.rows *))((* for cell in row *))((* if not loop.first *)) & ((* endif *))((( cell | tex )))((* endfor *)) \\ \hline
((* endfor *))\end{tabular}
\end{center}
\par\medskip
((* elif b.type == "mindmap" *))
((* if b.caption *)){\color{brand}\small\textbf{((( b.caption | tex )))}}\par\vspace{2pt}
((* endif *))
\begin{center}
\adjustbox{max width=0.95\linewidth,max totalheight=0.62\textheight}{%
\begin{forest}
[{((( b.root | tex )))}, mindmap
((* for br in b.branches *))((( mm_node(br) )))((* endfor *))
]
\end{forest}}
\end{center}
\par\medskip
((* elif b.type == "figure" *))
\begin{center}
((* if b.image *))
\includegraphics[width=((* if b.width *))((( b.width )))((* else *))0.5\textwidth((* endif *))]{((( b.image )))}
((* else *))
\resizebox{((* if b.width *))((( b.width )))((* else *))0.6\textwidth((* endif *))}{!}{((( b.tikz )))}
((* endif *))
((* if b.caption *))\par\vspace{3pt}{\footnotesize\itshape\color{muted}((( b.caption | tex )))}((* endif *))
\end{center}
\par\medskip
((* endif *))
((= writelines: bỏ qua trên slide =))
((* endmacro *))

((= Nút sơ đồ tư duy — đệ quy; label cho phép [[blank]]. Bọc trong {} để né dấu phẩy. =))
((* macro mm_node(node) *))
[{((( node.label | tex )))}
((* for c in node.children *))((( mm_node(c) )))((* endfor *))
]
((* endmacro *))

((= Hình trong CỘT PHẢI: lấp đầy bề ngang cột (cạnh phần lý thuyết bên trái), giới
    hạn CẢ chiều cao để không tràn xuống footer. BỎ caption trên slide (đề/lý thuyết
    bên trái đã mô tả; thầy giảng trực tiếp) — vừa gọn vừa chừa lề an toàn. =))
((* macro render_figure_col(b) *))
\begin{center}
((* if b.image *))\includegraphics[width=\linewidth,height=0.5\textheight,keepaspectratio]{((( b.image )))}
((* else *))\adjustbox{max width=\linewidth,max totalheight=0.5\textheight}{((( b.tikz )))}((* endif *))
\end{center}
((* endmacro *))

((= Mỗi "đơn vị dạy" (group_slide_segments) = MỘT slide con. Segment có hình →
    bố cục 2 cột: lý thuyết/đề bên TRÁI, hình bên PHẢI (dễ giảng, liền mạch).
    Segment chỉ-chữ → full width như cũ; chỉ-hình → căn giữa. =))
((* macro render_blocks(blocks) *))
((* for seg in group_slide_segments(blocks) *))
((* if not loop.first *))\framebreak
((* endif *))
((= Cột CHỮ của cols/opener cũng bọc adjustbox: chữ dài thì tự co, không tràn
    đè footer (đã dính với opener 3 câu hỏi thử nhanh). =))
((* if seg.mode == "cols" *))
\begin{columns}[T,onlytextwidth]
\begin{column}{0.58\textwidth}
\adjustbox{max width=\linewidth,max totalheight=0.62\textheight}{\begin{minipage}{\linewidth}
{\small ((* for b in seg.text *))((( render_block(b) )))((* endfor *))}
\end{minipage}}
\end{column}
\begin{column}{0.38\textwidth}
((* for f in seg.figures *))((( render_figure_col(f) )))((* endfor *))
\end{column}
\end{columns}
((* elif seg.mode == "opener" *))
\begin{columns}[T,onlytextwidth]
\begin{column}{0.56\textwidth}
\adjustbox{max width=\linewidth,max totalheight=0.62\textheight}{\begin{minipage}{\linewidth}
{\small ((* for b in seg.text *))((( render_block(b) )))((* endfor *))}
\end{minipage}}
\end{column}
\begin{column}{0.40\textwidth}
\vspace{6pt}((( render_figure_col(seg.text[0]) )))
\end{column}
\end{columns}
((* elif seg.mode == "stacked" *))
((= Bảng 2 hàng GIỮ CHUNG MỘT SLIDE: HÀNG 1 phần rút ra quy tắc (chữ), HÀNG 2 sơ
    đồ bước NẰM NGANG ở dưới. Bọc minipage để allowframebreaks KHÔNG tách đôi; bọc
    adjustbox (max totalheight) để CẢ CỤM tự co vừa khung, không đè footer. =))
\begin{center}
\adjustbox{max width=\linewidth,max totalheight=0.58\textheight}{%
\begin{minipage}{\linewidth}
{\small ((* for b in seg.text *))((( render_block(b) )))((* endfor *))}
\vspace{4pt}
((* for f in seg.figures *))\begin{center}((* if f.image *))\includegraphics[width=0.9\linewidth,height=0.3\textheight,keepaspectratio]{((( f.image )))}((* else *))\adjustbox{max width=0.9\linewidth,max totalheight=0.3\textheight}{((( f.tikz )))}((* endif *))\end{center}((* endfor *))
\end{minipage}}
\end{center}
((* elif seg.mode == "figonly" *))
((* for f in seg.figures *))((( render_block(f) )))((* endfor *))
((* elif seg.mode == "probfit" *))
((= Đề + câu nhỏ a,b,c: bọc minipage (không bị bẻ trang) + adjustbox (tự co nếu
    quá dài) → đề và các câu nhỏ LUÔN cùng một slide. =))
\adjustbox{max width=\linewidth,max totalheight=0.66\textheight}{%
\begin{minipage}{\linewidth}
((* for b in seg.text *))((( render_block(b) )))((* endfor *))
\end{minipage}}
((* else *))
((= Bọc minipage + adjustbox như probfit: segment chỉ-chữ KHÔNG bao giờ để beamer
    TỰ bẻ trang giữa block (auto-break trộn với \framebreak làm beamer dồn phần
    còn lại của frame vào một vbox quá khổ rồi CẮT MẤT — từng nuốt cả chặng
    Khái niệm; kèm thanh tiêu đề block mồ côi + slide trống). Dài quá thì tự co. =))
\adjustbox{max width=\linewidth,max totalheight=0.66\textheight}{%
\begin{minipage}{\linewidth}
((* for b in seg.text *))((( render_block(b) )))((* endfor *))
\end{minipage}}
((* endif *))
((* endfor *))
((* endmacro *))