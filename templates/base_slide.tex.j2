% SLIDE TRÌNH CHIẾU (16:9) — sinh tự động, không sửa tay.
% Mỗi chặng = 1 frame (tự bẻ trang nếu dài). Font sans to, toán STIX.
\documentclass[aspectratio=169,11pt]{beamer}

((* include "preamble/_beamer.tex.j2" *))

((* import "_slide_blocks.j2" as SB with context *))

\begin{document}

% --- Slide tiêu đề ---
\watermarkfalse
\begin{frame}[plain]
  % TikZ background for cover slide (dải trang trí trái; logo đưa vào dòng để
  % không đè chữ và để tiêu đề dài không bị tràn đáy).
  \begin{tikzpicture}[remember picture,overlay]
    \fill[color=brand] (current page.north west) rectangle ([xshift=0.3in]current page.south west);
    \fill[color=ink] ([xshift=0.3in]current page.north west) rectangle ([xshift=0.33in]current page.south west);
  \end{tikzpicture}

  \vspace*{0.3in}
  \begin{flushleft}
    \hspace*{0.55in}
    \begin{minipage}{0.82\textwidth}
      \includegraphics[height=26pt]{((( assets_dir )))((( branding.logo_file )))}\par\vspace{14pt}
      ((* if lesson.eyebrow *))
      {\color{brand}\sffamily\bfseries\normalsize ((( lesson.eyebrow | upper )))}\par\vspace{7pt}
      ((* endif *))
      {\bfseries\huge\color{ink}((( lesson.title | upper )))}\par\vspace{11pt}
      {\color{brand}\rule{120pt}{3pt}}\par\vspace{11pt}
      ((* if lesson.grade_label *))
      {\color{muted}\large\sffamily ((( lesson.grade_label )))}\par
      ((* endif *))
      \vspace{9pt}{\color{muted}\normalsize\sffamily Biên soạn: \textbf{((( branding.author_name )))} • ((( branding.author_phone )))}\par
    \end{minipage}
  \end{flushleft}
  \vfill
\end{frame}
\watermarktrue

% --- 5 chặng (reflection tách thêm 2 frame phụ: BTVN, Mở rộng) ---
((* for stage in lesson.stages *))
((* if stage.kind == "reflection" *))
((* set parts = split_reflection(stage.blocks) *))
\begin{frame}[allowframebreaks]{((( stage.number ))). ((( stage.title )))}
((( SB.render_blocks(parts.tong_ket) )))
\end{frame}
((* if parts.btvn *))
\begin{frame}[allowframebreaks]{Bài tập về nhà}
((( SB.render_blocks(parts.btvn) )))
\end{frame}
((* endif *))
((* if parts.mo_rong *))
\begin{frame}[allowframebreaks]{Bài tập mở rộng (tự chọn)}
((( SB.render_blocks(parts.mo_rong) )))
\end{frame}
((* endif *))
((* else *))
\begin{frame}[allowframebreaks]{((( stage.number ))). ((( stage.title )))}
((( SB.render_blocks(stage.blocks) )))
\end{frame}
((* endif *))
((* endfor *))

\end{document}
