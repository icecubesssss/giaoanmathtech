((= Macro Jinja dựng các Block nội dung. Token [[blank]] do filter `tex` xử lý. =))
((* macro render_block(b) *))
((* if b.type == "para" *))
((( b.text | tex )))

((* elif b.type == "math" *))
\[ ((( b.latex | tex ))) \]
((* elif b.type == "noted" *))
((* if b.variant == "trap" *))\begin{callouttrap}((( b.text | tex )))\end{callouttrap}
((* elif b.variant == "target" *))\begin{callouttarget}((( b.text | tex )))\end{callouttarget}
((* elif b.variant == "tip" *))\begin{callouttip}((( b.text | tex )))\end{callouttip}
((* elif b.variant == "example" *))\begin{calloutexample}((( b.text | tex )))\end{calloutexample}
((* else *))\begin{noted}((( b.text | tex )))\end{noted}((* endif *))

((* elif b.type == "opener" *))
\begin{openerbox}
((* if b.tikz *))\begin{minipage}[c]{0.63\linewidth}((( b.text | tex )))\end{minipage}\hfill\begin{minipage}[c]{0.34\linewidth}\centering\adjustbox{max width=\linewidth,max totalheight=3.4cm}{((( b.tikz )))}\end{minipage}((* elif b.image *))\begin{minipage}[c]{0.63\linewidth}((( b.text | tex )))\end{minipage}\hfill\begin{minipage}[c]{0.33\linewidth}\centering\adjustbox{max width=\linewidth,max totalheight=3.4cm}{\includegraphics{((( b.image )))}}\end{minipage}((* else *))((( b.text | tex )))((* endif *))
\end{openerbox}

((* elif b.type == "writelines" *))
((* if b.count == 0 *))\par\vspace{5mm}((* elif b.variant == "oly" *))\olyline[((( b.count )))]((* elif b.variant == "draw" *))\drawbox[((( b.count )))]((* else *))((* for _ in range(b.count) *))\fillline
((* endfor *))((* endif *))
\par
((* elif b.type == "problem" *))
((= MỖI BÀI LÀ MỘT ĐOẠN RIÊNG. Không có \par này thì bài nào không được seed chèn sẵn
    block writelines phía sau sẽ CHẢY TIẾP vào dòng bài trước ("… cạnh nào? Bài 8. …"
    — Thầy bắt 15/08/2026, dính 69 phiếu). \addvspace chứ không \vspace: seed cũ đã có
    writelines count=0 (=\vspace{5mm}) đứng giữa hai bài thì cộng thêm 0, khỏi dãn đôi. =))
\par\addvspace{5mm}
((= Hộp hình [[wrap]] treo bằng \smash (cao 0pt) nên TeX KHÔNG biết nó chiếm chỗ:
    bài rơi sát đáy trang thì hình vẽ đè lên chân trang. Môi trường `wrapclump`
    (xem preamble/_macros) gói đề + hình thành MỘT hộp không cắt được, nên hết chỗ
    thì cả cụm nhảy sang trang sau. TUYỆT ĐỐI không dùng \needspace ở đây: nó nằm
    trong tcolorbox breakable nên ép ngắt trang ở MỌI bài có hình. =))
((= ĐỀ KHÔNG ĐƯỢC BỎ LẠI MỘT DÒNG LẺ ở đầu/cuối trang (bọc trong {} cho khỏi rò sang
    đoạn sau). Đề 2-3 dòng thì thành ra không cắt được ⇒ cả bài nhảy sang trang mới,
    đúng ý "đề với chỗ viết phải đi cùng nhau".
    KHÔNG dùng \interlinepenalty=10000 (cấm cắt HẲN): đề nhiều ý a), b), c) nối bằng
    [[br]] là MỘT đoạn dài chục dòng, cấm cắt thì cả cụm nhảy trang, để lại 10-11cm
    trắng (phiếu A trang 4, phiếu B trang 7 & 13). =))
{\clubpenalty=10000 \widowpenalty=10000 \relax
((* set _w = "[[/wrap]]" in b.statement *))((* if _w *))\begin{wrapclump}\leavevmode\hangafter=-5\hangindent=-0.38\linewidth\relax((( b.statement.split("[[/wrap]]")[0] | replace("[[wrap]]","") )))((* endif *))\textbf{((( b.label | tex )))}((* if b.level *))~\diffstars{((( b.level )))}((* elif b.tier == "onclass" *))~\diffstars{2}((* elif b.tier == "btvn" *))~\diffstars{1}((* elif b.tier == "extend" *))~\diffstars{3}((* endif *)) ((( (b.statement.split("[[/wrap]]")[1] if _w else b.statement) | tex )))((* if _w *))\end{wrapclump}((* endif *))
\par}
((* if b.video *))\videoqr{((( b.video )))}((* endif *))
((= Chỗ viết khai thẳng trên bài (`"writelines": N`) — bằng một WriteLinesBlock đặt sau. =))
((* if b.writelines *))\par
((* for _ in range(b.writelines) *))\fillline
((* endfor *))\par
((* endif *))
((* if b.hints *))
\par\vspace{3pt}
\begin{hintbox}{\itshape\color{brand}Gợi ý:}\par
((* for h in b.hints *))\textbullet\ ((( h | tex )))((* if not loop.last *))\par((* endif *))
((* endfor *))\end{hintbox}
((* endif *))
((= Lời giải từng bài — CHỈ in ở Sổ tay GV (show_solution=True), không lọt sang phiếu HS. =))
((* if show_solution and b.solution *))
\par\nopagebreak
\begin{answerbox}{\sffamily\bfseries Lời giải.}~((( b.solution | tex )))\end{answerbox}
((* endif *))

((* elif b.type == "table" *))
((* if b.caption *)){\sffamily\footnotesize\color{brand}\textbf{((( b.caption | tex )))}}\par\vspace{2pt}
((* endif *))
((* set ncols = (b.headers | length) or ((b.rows[0] | length) if b.rows else 1) *))
\begin{center}\renewcommand{\arraystretch}{1.5}
\begin{tabular}{|((* for i in range(ncols) *))((* if loop.first *))l((* else *))c((* endif *))|((* endfor *))}
\hline
((* if b.headers *))((* for h in b.headers *))((* if not loop.first *)) & ((* endif *))\textbf{((( h | tex )))}((* endfor *)) \\ \hline
((* endif *))((* for row in b.rows *))((* for cell in row *))((* if not loop.first *)) & ((* endif *))((( cell | tex )))((* endfor *)) \\ \hline
((* endfor *))\end{tabular}
\end{center}

((* elif b.type == "mindmap" *))
((* if b.caption *)){\sffamily\footnotesize\color{brand}\textbf{((( b.caption | tex )))}}\par\vspace{2pt}
((* endif *))
((= adjustbox: sơ đồ nhiều nhánh dài hơn bề ngang cột chữ thì TỰ CO, không thì
    forest vẽ tràn ra ngoài lề phải và bị xén mất (phiếu C chương IV từng mất
    nguyên hai nhánh). =))
\begin{center}
\adjustbox{max width=\linewidth}{%
\begin{forest}
[{((( b.root | tex )))}, mindmap
((* for br in b.branches *))((( mm_node(br) )))((* endfor *))
]
\end{forest}}
\end{center}

((* elif b.type == "figure" *))
\begin{center}
((* if b.image *))
\includegraphics[width=((* if b.width *))((( b.width )))((* else *))0.55\linewidth((* endif *))]{((( b.image )))}
((* else *))
\adjustbox{max width=((* if b.width *))((( b.width )))((* else *))0.9\linewidth((* endif *))}{((( b.tikz )))}
((* endif *))
((* if b.caption *))\par\vspace{3pt}{\sffamily\footnotesize\itshape\color{muted}((( b.caption | tex )))}((* endif *))
\end{center}

((* endif *))
((* endmacro *))

((= Nút sơ đồ tư duy — đệ quy; label cho phép [[blank]]. Bọc trong {} để né dấu phẩy. =))
((* macro mm_node(node) *))
[{((( node.label | tex )))}
((* for c in node.children *))((( mm_node(c) )))((* endfor *))
]
((* endmacro *))

((= Bỏ các writelines RỖNG (count=0) đứng ĐẦU danh sách: chúng chỉ đẻ khoảng trắng
    chết ngay dưới đầu mục chặng / banner BTVN, đọc như thể chặng bị bỏ trống.
    Và \nopagebreak giữa BÀI với chỗ viết của nó: chỗ viết (nhất là khung vẽ hình,
    một hộp không cắt được) mà rơi sang trang sau thì HS đọc đề một trang, vẽ ở
    trang khác. Cấm ngắt ở đó ⇒ TeX đẩy cả cụm sang trang mới. =))
((* macro render_blocks(blocks) *))
((* set ns = namespace(batdau=false, truoc="") *))
((* for b in blocks *))((* if ns.batdau or not (b.type == "writelines" and not b.count) *))((* set ns.batdau = true *))((* if b.type == "writelines" and b.count and ns.truoc == "problem" *))\nopagebreak
((* endif *))((( render_block(b) )))((* set ns.truoc = b.type *))((* endif *))((* endfor *))
((* endmacro *))
