          "diem_uoc": {"type": "boolean"},
          "muc": {"type": "string", "enum": ["NB", "TH", "VD", "VDC"]},
          "dang": {"type": "string", "pattern": "^D[0-9]{2}$"},
          "nd": {"type": "string"},
          "dap_an": {"type": "string"},
          "co_hinh": {"type": "boolean"},
          "can_soat": {"type": "string"}
